# Neo4j 配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

# ChromaDB 配置
CHROMADB_PATH=./data/chromadb

# 数据集路径
DATASET_PATH=./data/mramg_bench
DOCS_JSONL=./data/mramg_bench/docs.jsonl
QA_JSONL=./data/mramg_bench/qa.jsonl
IMAGES_PATH=./data/mramg_bench/images

# API Keys
OPENAI_API_KEY=sk-your-key-here
# 或使用 Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here

# 检索配置
VECTOR_TOP_K=5
GRAPH_MAX_HOPS=2

# CLIP 模型
CLIP_MODEL_NAME=ViT-B/32

# 输出路径
OUTPUT_PATH=./output
